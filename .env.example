# Echoback configuration. Copy to `.env` and edit — `.env` is gitignored.
#
#   cp .env.example .env
#
# Every value here is optional; the defaults shown are what the service uses when
# the variable is unset. See README "Configuration" for the full table.

# ---- networking ------------------------------------------------------------
# Listen port inside the container. TLS terminates at your reverse proxy.
PORT=80

# Public URL this service is reached on, as configured on the upstream proxy.
# Makes `status_url` in the 202 response absolute, and lets the service refuse a
# callback_url that points back at itself.
# HOST_URL=https://voicemail.example.com

# ---- callbacks -------------------------------------------------------------
# Comma-separated hosts that callback_url may point at. Unset means any host,
# subject to the address policy (loopback, link-local, multicast and reserved
# addresses are always refused; private LAN ranges are allowed).
# A leading dot matches subdomains: `.example.com` allows `flows.example.com`.
# CALLBACK_ALLOWED_HOSTS=activepieces.internal,.example.com

# ---- transcription ---------------------------------------------------------
MODEL_DEFAULT=small
# MODEL_ALLOWLIST=tiny,tiny.en,base,base.en,small,small.en,medium,medium.en

# Default vocabulary hint for jobs that send none. Domain vocabulary only —
# per-call proper nouns belong in the request's vocabulary_hint field, not here.
# VOCABULARY_HINT=invoice, purchase order, back-order, RMA, dispatch
# MAX_VOCABULARY_HINT_CHARS=1000

# ---- limits ----------------------------------------------------------------
MAX_UPLOAD_MB=25
MAX_QUEUE_DEPTH=1000
MAX_QUEUE_MB=2048
RETENTION_MINUTES=60

# ---- webhook ---------------------------------------------------------------
WEBHOOK_ATTEMPTS=5
WEBHOOK_BACKOFF=2

# ---- secrets ---------------------------------------------------------------
# Leave unset to have both generated on first boot and printed once to the logs.
# Set them here to supply your own — NEVER commit real values.
# API_TOKEN=
# WEBHOOK_SECRET=
# ROTATE_SECRETS=false

# ---- misc ------------------------------------------------------------------
LOG_LEVEL=info
DATA_DIR=/data
